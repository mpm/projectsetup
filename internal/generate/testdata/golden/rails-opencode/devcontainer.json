{
  "name": "rails-app",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/rails-app",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/rails-app,type=bind",
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/rails/devcontainer/features/activestorage": {},
    "ghcr.io/rails/devcontainer/features/ruby:2": {
      "usePrecompiledRubies": true,
      "version": "3.3"
    }
  },
  "containerEnv": {
    "PATH": "/home/vscode/.local/bin:/home/vscode/.opencode/bin:/home/vscode/.local/share/mise/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  },
  "mounts": [
    "source=${localEnv:HOME}/.config/opencode,target=/home/vscode/.config/opencode,type=bind",
    "source=${localEnv:HOME}/.local/share/opencode,target=/home/vscode/.local/share/opencode,type=bind",
    "source=${localEnv:HOME}/.opencode,target=/home/vscode/.opencode,type=bind",
    "source=${localEnv:HOME}/.cache/opencode,target=/home/vscode/.cache/opencode,type=bind"
  ],
  "runArgs": [
    "--name",
    "rails-app-app"
  ],
  "postCreateCommand": ".devcontainer/scripts/post-create.sh"
}
