{
  "name": "python-codex",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/python-codex",
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14"
    }
  },
  "containerEnv": {
    "CODEX_HOME": "/home/vscode/.codex",
    "PATH": "/home/vscode/.local/bin:/home/vscode/.opencode/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  },
  "mounts": [
    "source=${localEnv:HOME}/.local/share/codex,target=/home/vscode/.local/share/codex,type=bind"
  ],
  "postCreateCommand": ".devcontainer/scripts/post-create.sh",
  "shutdownAction": "stopCompose"
}
