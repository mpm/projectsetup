{
  "name": "wayland-app",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/wayland-app",
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "26"
    }
  },
  "containerEnv": {
    "PATH": "/home/vscode/.local/bin:/home/vscode/.opencode/bin:/usr/local/share/nvm/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "WAYLAND_DISPLAY": "/run/host-wayland/wayland-0"
  },
  "mounts": [
    "source=${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY},target=/run/host-wayland/wayland-0,type=bind,readonly"
  ],
  "postCreateCommand": ".devcontainer/scripts/post-create.sh",
  "shutdownAction": "stopCompose"
}
