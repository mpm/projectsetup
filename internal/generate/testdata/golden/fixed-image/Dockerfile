FROM registry.example/team/toolchain:fixed


USER root
# Fixed IDs must already exist before any user-owned toolchain installation.
RUN test "$(id -u vscode)" = "1001" \
    && test "$(id -g vscode)" = "1002" \
    || { echo 'projectsetup: base vscode IDs differ from image.ownership; rebuild the base with the declared IDs before installing toolchains' >&2; exit 1; }
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash ca-certificates curl git gnupg sudo \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /home/vscode/.local/bin /home/vscode/.local/state /home/vscode/.local/share /home/vscode/.config /home/vscode/.cache \
    && chown --no-dereference vscode:vscode /home/vscode /home/vscode/.local /home/vscode/.local/bin /home/vscode/.local/state /home/vscode/.local/share /home/vscode/.config /home/vscode/.cache

USER vscode
