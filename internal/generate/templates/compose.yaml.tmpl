# Generated by projectsetup. Edit projectsetup.json and regenerate instead of editing this file.
name: {{.Config.Container.ComposeProjectName}}

services:
  {{.Config.Container.ServiceName}}:
    build:
      context: ..
      dockerfile: .devcontainer/Dockerfile
    command: sleep infinity
    user: vscode
    volumes:
      - ..:{{.Config.Workspace.ContainerPath}}
{{if .Codex}}      - type: bind
        source: "{{.CodexStateSource}}"
        target: /home/vscode/.codex
{{end}}{{if eq .Config.Database "postgres"}}    depends_on:
      postgres:
        condition: service_healthy

  postgres:
    image: {{.PostgresImage}}
    restart: unless-stopped
    environment:
      POSTGRES_USER: projectsetup
      POSTGRES_PASSWORD: projectsetup
      POSTGRES_DB: '{{.Config.ProjectName}}'
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U projectsetup -d {{.Config.ProjectName}}"]
      interval: 5s
      timeout: 5s
      retries: 10
    volumes:
      - postgres-data:{{.PostgresDataPath}}

volumes:
  postgres-data:
{{end -}}
