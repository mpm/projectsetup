{{if eq .Config.Preset "rails"}}FROM ghcr.io/rails/devcontainer/images/ruby:{{.Config.LanguageVersion}}
{{else}}FROM mcr.microsoft.com/devcontainers/base:ubuntu-24.04
{{end}}

USER root
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash ca-certificates curl git gnupg sudo{{if and (eq .Config.Database "postgres") (ne .Config.Preset "rails")}} \
        libpq-dev postgresql-client{{end}}{{range .Config.SystemPackages}} \
        {{.}}{{end}} \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /home/vscode/.local/bin /home/vscode/.local/state \
    && chown -R vscode:vscode /home/vscode/.local

USER vscode
